# Neon PostgreSQL Connection String
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Database command safety target: development | test | production
# This value is REQUIRED by db:migrate and db:push wrappers.
DB_ENV="development"

# Production migrations require an explicit one-command acknowledgement.
# Do NOT keep this enabled permanently in .env.local.
# ALLOW_PRODUCTION_DB_MIGRATION="YES_I_UNDERSTAND"

# Better Auth Configuration
BETTER_AUTH_SECRET="your_32_character_better_auth_secret_key_here"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
